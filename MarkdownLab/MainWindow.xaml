<Window x:Class="MarkdownLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="MarkdownLab" Width="1200" Height="800" MinWidth="760" MinHeight="480" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" Icon="Assets/MarkdownLab.ico">
<Window.Resources>
<SolidColorBrush x:Key="Surface" Color="#181B22"/><SolidColorBrush x:Key="Panel" Color="#222630"/><SolidColorBrush x:Key="Ink" Color="#E6EAF2"/><SolidColorBrush x:Key="Muted" Color="#A4AFC1"/><SolidColorBrush x:Key="Edge" Color="#383F4D"/><SolidColorBrush x:Key="Accent" Color="#42669D"/>
<Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/><Setter Property="Padding" Value="8"/></Style>
</Window.Resources>
<DockPanel>
<Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="12,8" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1"><WrapPanel VerticalAlignment="Center">
<Image Source="Assets/MarkdownLab.ico" Width="28" Height="28" Margin="0,0,10,0"/>
<Button Content="＋ Nuevo" Click="New_Click"/><Button Content="📂 Abrir" Click="Open_Click" ToolTip="Ctrl+O"/><Button Content="▣ Guardar" Click="Save_Click" ToolTip="Ctrl+S"/><Button Content="▣…" Click="SaveAs_Click" ToolTip="Guardar como (Ctrl+Shift+S)" AutomationProperties.Name="Guardar como"/>
<Button Content="☰ Índice" Click="ToggleOutline_Click" Margin="12,3,3,3"/>
<Button x:Name="ReadButton" Content="Lectura" Click="Read_Click"/><Button x:Name="EditButton" Content="Edición" Click="Edit_Click"/><Button x:Name="SplitButton" Content="Dividida" Click="Split_Click"/>
<TextBox x:Name="SearchBox" Width="145" Margin="12,3,0,3" ToolTip="Buscar en el documento" KeyDown="Search_KeyDown"/><Button Content="Buscar" Click="Find_Click"/>
<Button Content="A−" Click="ZoomOut_Click"/><Button Content="A+" Click="ZoomIn_Click"/><Button Content="◐ Tema" Click="Theme_Click"/>
</WrapPanel></Border>
<Border x:Name="FormatBar" DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Padding="12,3" Visibility="Collapsed"><WrapPanel><TextBlock Text="Markdown" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="4,0,12,0"/><Button Content="B" ToolTip="Negrita · **texto**" AutomationProperties.Name="Negrita · **texto**" Tag="bold" Click="Format_Click" Focusable="False" Padding="9,5" FontWeight="Bold"/><Button Content="I" ToolTip="Cursiva · *texto*" AutomationProperties.Name="Cursiva · *texto*" Tag="italic" Click="Format_Click" Focusable="False" Padding="9,5" FontStyle="Italic"/><Button Content="S" ToolTip="Tachado · ~~texto~~" AutomationProperties.Name="Tachado · ~~texto~~" Tag="strike" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="H1" ToolTip="Título 1 · #" AutomationProperties.Name="Título 1 · #" Tag="h1" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="H2" ToolTip="Título 2 · ##" AutomationProperties.Name="Título 2 · ##" Tag="h2" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="H3" ToolTip="Título 3 · ###" AutomationProperties.Name="Título 3 · ###" Tag="h3" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="H4" ToolTip="Título 4 · ####" AutomationProperties.Name="Título 4 · ####" Tag="h4" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="H5" ToolTip="Título 5 · #####" AutomationProperties.Name="Título 5 · #####" Tag="h5" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="H6" ToolTip="Título 6 · ######" AutomationProperties.Name="Título 6 · ######" Tag="h6" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="•" ToolTip="Lista · -" AutomationProperties.Name="Lista · -" Tag="bullet" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="1." ToolTip="Lista numerada · 1." AutomationProperties.Name="Lista numerada · 1." Tag="number" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="☑" ToolTip="Tarea · - [ ]" AutomationProperties.Name="Tarea · - [ ]" Tag="task" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="❝" ToolTip="Cita · &gt;" AutomationProperties.Name="Cita · &gt;" Tag="quote" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="&lt;/&gt;" ToolTip="Código en línea · `código`" AutomationProperties.Name="Código en línea · `código`" Tag="code" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="{}{ }" ToolTip="Bloque de código · ```" AutomationProperties.Name="Bloque de código · ```" Tag="fence" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="🔗" ToolTip="Enlace · [texto](url)" AutomationProperties.Name="Enlace · [texto](url)" Tag="link" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="▧" ToolTip="Imagen · ![texto](url)" AutomationProperties.Name="Imagen · ![texto](url)" Tag="image" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="▦" ToolTip="Tabla Markdown" AutomationProperties.Name="Tabla Markdown" Tag="table" Click="Format_Click" Focusable="False" Padding="9,5" /><Button Content="―" ToolTip="Separador · ---" AutomationProperties.Name="Separador · ---" Tag="rule" Click="Format_Click" Focusable="False" Padding="9,5" /></WrapPanel></Border><Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="12,7"><DockPanel><TextBlock x:Name="Stats" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="StatusText" Text="Sin documento" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/></DockPanel></Border>
<Grid x:Name="RootGrid"><Grid.ColumnDefinitions><ColumnDefinition x:Name="OutlineColumn" Width="230"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel x:Name="OutlinePanel" Background="{DynamicResource Panel}"><TextBlock DockPanel.Dock="Top" Text="CONTENIDOS" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="16,20,12,12"/><ListBox x:Name="OutlineList" SelectionChanged="Outline_SelectionChanged" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" Margin="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4,3"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
<GridSplitter x:Name="OutlineSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Edge}"/>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource Panel}" Padding="16,10"><TextBlock x:Name="DocumentName" Text="Sin título" FontWeight="SemiBold"/></Border>
<Grid x:Name="ContentGrid" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="*"/></Grid.ColumnDefinitions>
<ae:TextEditor x:Name="Editor" Grid.Column="0" ShowLineNumbers="True" FontFamily="Consolas" FontSize="15" Padding="12" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" LineNumbersForeground="{DynamicResource Muted}" TextChanged="Editor_TextChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ae:TextEditor.ContextMenu><ContextMenu Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}"><MenuItem Header="Deshacer" Tag="undo" InputGestureText="Ctrl+Z" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Rehacer" Tag="redo" InputGestureText="Ctrl+Y" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Cortar" Tag="cut" InputGestureText="Ctrl+X" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Copiar" Tag="copy" InputGestureText="Ctrl+C" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Pegar" Tag="paste" InputGestureText="Ctrl+V" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Seleccionar palabra" Tag="word" InputGestureText="" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Seleccionar todo" Tag="all" InputGestureText="Ctrl+A" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/><MenuItem Header="Buscar" Tag="find" InputGestureText="Ctrl+F" Click="EditorMenu_Click" Foreground="{DynamicResource Ink}"/></ContextMenu></ae:TextEditor.ContextMenu></ae:TextEditor>
<wv:WebView2 x:Name="Preview" Grid.Column="1"/>
</Grid>
<Border x:Name="Welcome" Grid.Row="1" Background="{DynamicResource Surface}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320"><Image Source="Assets/MarkdownLab.ico" Width="72" Height="72"/><TextBlock Text="MarkdownLab" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="Abre o arrastra un documento Markdown" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,20"/><Button Content="Abrir documento" Click="Open_Click" Background="{DynamicResource Accent}"/><Button Content="Crear documento" Click="New_Click"/></StackPanel></Border>
</Grid></Grid></DockPanel></Window>