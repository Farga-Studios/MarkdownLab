<Window x:Class="MarkdownLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MarkdownLab" Width="1200" Height="800" MinWidth="650" MinHeight="450" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Background="#181B23">
 <DockPanel>
  <ToolBar DockPanel.Dock="Top" Background="#252936">
   <Button Click="Open_Click" Content="Abrir  Ctrl+O"/>
   <Button Click="Save_Click" Content="Guardar  Ctrl+S"/>
   <Separator/>
   <Button Click="Read_Click" Content="Lectura"/>
   <Button Click="Edit_Click" Content="Edición"/>
   <Button Click="Split_Click" Content="Dividida"/>
   <Separator/>
   <Button Click="Theme_Click" Content="Claro / oscuro"/>
   <Button Click="ZoomOut_Click" Content="A−"/>
   <Button Click="ZoomIn_Click" Content="A+"/>
   <Separator/>
   <TextBox x:Name="SearchBox" Width="160" ToolTip="Buscar en el documento" KeyDown="Search_KeyDown"/>
   <Button Click="Find_Click" Content="Buscar"/>
  </ToolBar>
  <StatusBar DockPanel.Dock="Bottom" Background="#252936"><TextBlock x:Name="StatusText" Foreground="#E0E4F0" Text="Sin documento"/></StatusBar>
  <Grid x:Name="RootGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel x:Name="OutlinePanel" Grid.Column="0" Background="#252936">
    <TextBlock DockPanel.Dock="Top" Text="ÍNDICE" FontWeight="Bold" Foreground="#AEB9D1" Margin="14"/>
    <ListBox x:Name="OutlineList" SelectionChanged="Outline_SelectionChanged" Background="Transparent" Foreground="#E0E4F0" BorderThickness="0" Margin="6"/>
   </DockPanel>
   <Grid x:Name="ContentGrid" Grid.Column="1">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="*"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Editor" Grid.Column="0" TextChanged="Editor_TextChanged" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="15" Padding="16" Background="#1D202A" Foreground="#ECEEF5" BorderThickness="0"/>
    <WebBrowser x:Name="Preview" Grid.Column="1" Navigating="Preview_Navigating"/>
   </Grid>
  </Grid>
 </DockPanel>
</Window>