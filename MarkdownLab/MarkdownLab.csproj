<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets/MarkdownLab.ico</ApplicationIcon>
    <AssemblyName>MarkdownLab</AssemblyName>
    <Version>1.7.1</Version>
    <Company>Farga Studios</Company>
    <Authors>Farga Studios</Authors>
    <Product>MarkdownLab</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Farga-Studios/MarkdownLab</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/MarkdownLab.ico" />
    <EmbeddedResource Include="Updates/PublicKey.pem" LogicalName="MarkdownLab.Updates.PublicKey.pem" Condition="Exists('Updates/PublicKey.pem')" />
    <PackageReference Include="FargaStudios.Suite.Updater" Version="0.3.0-rc.2" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>
</Project>